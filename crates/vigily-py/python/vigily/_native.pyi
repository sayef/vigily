__version__: str

class RunDeletedError(LookupError): ...

class RunHandle:
    @property
    def id(self) -> str: ...
    def heartbeat(self) -> None: ...
    def info(self) -> str: ...
    def track(
        self,
        name: str,
        value: float,
        step: int | None = None,
        epoch: int | None = None,
        context: str | None = None,
        timestamp: int | None = None,
    ) -> None: ...
    def set_params(self, params: str) -> None: ...
    def set_param(self, key: str, value: str) -> None: ...
    def update(self, patch: str) -> None: ...
    def finish(self, status: str, ended_at: int | None = None) -> None: ...
    def flush(self) -> None: ...

class Repo:
    def __init__(self, location: str) -> None: ...
    @property
    def location(self) -> str: ...
    def create_run(
        self,
        name: str | None = None,
        experiment: str | None = None,
        description: str | None = None,
        tags: list[str] = ...,
        run_id: str | None = None,
        created_at: int | None = None,
        kind: str | None = None,
        target: str | None = None,
    ) -> RunHandle: ...
    def open_run(self, run_id: str) -> RunHandle: ...
    def runs(self) -> str: ...
    def params(self, run_id: str) -> str: ...
    def series(self, run_id: str) -> str: ...
    def points(
        self,
        run_id: str,
        name: str,
        context: str,
        start_time: int | None = None,
        stop_time: int | None = None,
    ) -> tuple[list[int], list[float], list[int | None], list[int]]: ...
    def flush(self) -> None: ...
    def delete_runs(self, run_ids: list[str]) -> int: ...
    def commit_dataset(
        self,
        name: str,
        items: str,
        mode: str = "replace",
        note: str | None = None,
        description: str | None = None,
        source: str | None = None,
    ) -> str: ...
    def datasets(self) -> str: ...
    def dataset_version(self, name: str, version: int | None = None) -> str: ...
    def dataset_versions(self, name: str) -> str: ...
    def dataset_items(self, name: str, version: int | None = None) -> str: ...
    def put_results(self, results: str) -> None: ...
    def put_spans(self, spans: str, config: str) -> str: ...
    def results(self, run_id: str) -> str: ...
    def put_features(self, samples: str) -> None: ...
    def optimize(self) -> None: ...
    def close(self) -> None: ...
